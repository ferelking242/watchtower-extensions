    "baseUrl": "https://www.mangaworld.ac",
    "lang": "it",
    "typeSource": "single",
    "iconUrl": "https://www.mangaworld.ac/public/assets/images/MangaWorldSquareLogo.png",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "",
    "version": "0.0.1",
    "isManga": true,
    "itemType": 0,
    "isFullData": false,
    "appMinVerReq": "0.5.0",
