    "typeSource": "single",
    "iconUrl": "https://raw.githubusercontent.com/m2k3a/mangayomi-extensions/main/javascript/icon/all.annasarchive.png",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": true,
    "apiUrl": "",
    "version": "0.0.2",
    "isManga": false,
    "itemType": 2,
    "isFullData": false,
