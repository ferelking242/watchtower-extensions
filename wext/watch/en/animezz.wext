    "iconUrl": "https://www.google.com/s2/favicons?sz=256&domain=https://animeyy.com",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "",
    "version": "1.1.1",
    "isManga": false,
    "itemType": 1,
    "isFullData": false,
    "appMinVerReq": "0.5.0",
