{
  "format": "wext/1.0",
  "metadata": {
    "name": "AnimeParadise",
    "id": 1800002033,
    "baseUrl": "https://animeparadise.moe",
    "lang": "en",
    "typeSource": "single",
    "iconUrl": "https://www.google.com/s2/favicons?sz=128&domain=https://animeparadise.moe",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "https://api.animeparadise.moe",
    "version": "0.1.0",
    "isManga": false,
    "itemType": 1,
    "isFullData": false,
    "appMinVerReq": "0.5.0",
    "additionalParams": "",
