{
  "format": "wext/1.0",
  "metadata": {
    "name": "AnimeFLV",
    "id": 537733556,
    "baseUrl": "https://www3.animeflv.net",
    "lang": "es",
    "typeSource": "single",
    "iconUrl": "https://raw.githubusercontent.com/ferelking242/watchtower/main/extensions/watch/icon/es.animeflv.png",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "",
    "version": "0.1.2",
    "isManga": false,
    "itemType": 1,
    "isFullData": false,
    "appMinVerReq": "0.5.0",
    "additionalParams": "",
