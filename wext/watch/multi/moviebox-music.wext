    "typeSource": "single",
    "iconUrl": "https://h5-static.aoneroom.com/oneroomProject/icon/moviebox-official.jpg",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "https://h5-api.aoneroom.com",
    "version": "1.0.0",
    "isManga": false,
    "itemType": 1,
    "isFullData": false,
