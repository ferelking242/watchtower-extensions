{
  "format": "wext/1.0",
  "metadata": {
    "name": "MovieBox — All",
    "id": 1800000035,
    "baseUrl": "https://h5.aoneroom.com",
    "lang": "multi",
    "typeSource": "single",
    "iconUrl": "https://h5-static.aoneroom.com/oneroomProject/icon/moviebox-official.jpg",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "https://h5-api.aoneroom.com",
    "version": "1.0.0",
