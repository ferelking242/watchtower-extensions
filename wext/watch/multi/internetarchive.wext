    "iconUrl": "https://www.google.com/s2/favicons?sz=256&domain=archive.org",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "https://archive.org/advancedsearch.php",
