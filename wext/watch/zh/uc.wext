{
  "format": "wext/1.0",
  "metadata": {
    "name": "小米UC资源站",
    "id": 1800002065,
    "baseUrl": "http://www.mucpan.cc",
    "lang": "zh",
    "typeSource": "single",
    "iconUrl": "http://www.mucpan.cc/template/DYXS2/static/picture/index_logo.png",
    "dateFormat": "",
    "dateFormatLocale": "",
    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "",
    "version": "0.0.3",
    "isManga": false,
