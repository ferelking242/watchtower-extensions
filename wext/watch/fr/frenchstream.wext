    "isNsfw": false,
    "hasCloudflare": false,
    "apiUrl": "https://french-stream.one",
    "version": "0.3.0",
    "isManga": false,
    "itemType": 1,
    "isFullData": false,
    "appMinVerReq": "0.5.0",
    "additionalParams": "",
    "sourceCodeLanguage": 1,
    "notes": "v0.3.0: real API — film_api.php for films, get_seasons+static/series for episodes",
