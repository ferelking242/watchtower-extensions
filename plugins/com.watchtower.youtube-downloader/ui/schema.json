{
  "title": "YouTube Downloader",
  "description": "Téléchargez des vidéos et de l'audio depuis YouTube",
  "color": "#E53935",
  "sections": [
    {
      "id": "search",
      "title": "Recherche",
      "inputs": [
        {
          "id": "url",
          "type": "text",
          "label": "URL ou recherche",
          "placeholder": "Rechercher ou insérer une URL",
          "icon": "search",
          "required": true
        }
      ]
    },
    {
      "id": "format",
      "title": "Format",
      "inputs": [
        {
          "id": "type",
          "type": "chip_select",
          "label": "Type de contenu",
          "options": [
            "Vidéo",
            "Audio uniquement"
          ],
          "default": "Vidéo"
        },
        {
          "id": "quality",
          "type": "chip_select",
          "label": "Qualité vidéo",
          "options": [
            "2160p",
            "1440p",
            "1080p",
            "720p",
            "480p",
            "360p"
          ],
          "default": "1080p"
        },
        {
          "id": "audio_format",
          "type": "chip_select",
          "label": "Format audio",
          "options": [
            "mp3",
            "m4a",
            "opus",
            "aac",
            "flac"
          ],
          "default": "mp3"
        }
      ]
    },
    {
      "id": "options",
      "title": "Options",
      "inputs": [
        {
          "id": "subtitles",
          "type": "toggle",
          "label": "Télécharger les sous-titres",
          "default": false
        },
        {
          "id": "thumbnail",
          "type": "toggle",
          "label": "Intégrer la miniature",
          "default": true
        },
        {
          "id": "metadata",
          "type": "toggle",
          "label": "Intégrer les métadonnées",
          "default": true
        }
      ]
    },
    {
      "id": "action",
      "inputs": [
        {
          "id": "download",
          "type": "button",
          "label": "Télécharger",
          "style": "primary",
          "icon": "download",
          "action": {
            "command": "yt-dlp",
            "buildArgs": [
              "${url}",
              "-f",
              "${quality}",
              "--audio-format",
              "${audio_format}"
            ]
          }
        }
      ]
    }
  ]
}