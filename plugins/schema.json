{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Watchtower Plugin Manifest",
  "description": "Schema for Watchtower plugin manifests. Each plugin must have a manifest.json at its root.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "author",
    "runtime",
    "ui",
    "permissions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$",
      "description": "Reverse-domain unique identifier. e.g. com.watchtower.tiktok-dl"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "longDescription": {
      "type": "string",
      "description": "Full Markdown description shown on the detail page"
    },
    "icon": {
      "type": "string",
      "description": "Relative path to 64×64 PNG icon or HTTPS URL"
    },
    "banner": {
      "type": "string",
      "description": "Optional banner image (HTTPS URL or relative path) shown on detail page"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "description": "List of screenshot URLs or relative paths shown in the detail page carousel"
    },
    "category": {
      "type": "string",
      "enum": [
        "sync",
        "theme",
        "downloader",
        "reader",
        "player",
        "tools",
        "social",
        "ai",
        "other"
      ]
    },
    "runtime": {
      "type": "string",
      "enum": [
        "javascript",
        "wasm",
        "remote",
        "binary"
      ],
      "description": "Execution environment for plugin logic"
    },
    "ui": {
      "description": "UI system used by the plugin. Either a legacy string value or an object with method.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "flutter_eval",
            "eval",
            "webview",
            "html",
            "declarative",
            "json",
            "builtin"
          ],
          "description": "Legacy string form"
        },
        {
          "type": "object",
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "eval",
                "json",
                "html",
                "builtin"
              ],
              "description": "UI rendering method"
            },
            "evalSource": {
              "type": "string",
              "description": "Relative path to the Dart source file for flutter_eval rendering"
            },
            "schema": {
              "type": "string",
              "description": "Relative path to the declarative JSON schema file"
            },
            "htmlFallback": {
              "type": "string",
              "description": "Relative path to the HTML fallback file"
            },
            "template": {
              "type": "string",
              "description": "Built-in UI template name"
            }
          }
        }
      ]
    },
    "entry": {
      "type": "string",
      "description": "Entry point script filename (used when runtime is binary/python)"
    },
    "scriptRuntime": {
      "type": "string",
      "description": "Script interpreter/runtime identifier (e.g. python3.11)"
    },
    "permissions": {
      "type": "array",
      "description": "Watchtower API permissions the plugin requires. The user must grant these before installation.",
      "items": {
        "type": "string",
        "enum": [
          "network",
          "storage.read",
          "storage.write",
          "downloads",
          "notifications",
          "player",
          "reader",
          "account",
          "clipboard",
          "camera",
          "microphone",
          "filesystem",
          "database",
          "crypto",
          "system",
          "cron",
          "anilist",
          "debrid",
          "torrent-client"
        ]
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "description": "External binary dependencies required by this plugin (e.g. zeusdl, aria2, ffmpeg, yt-dlp).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Binary identifier as registered in Watchtower's binary manager."
          },
          "version": {
            "type": "string",
            "description": "Semver version constraint. e.g. >=1.0.0, ^2.0.0, *"
          },
          "optional": {
            "type": "boolean",
            "default": false,
            "description": "If true, the plugin works without this binary (reduced functionality)"
          },
          "reason": {
            "type": "string",
            "description": "Human-readable explanation of why this binary is needed"
          }
        }
      }
    },
    "commandScopes": {
      "type": "array",
      "description": "Specific binary commands this plugin is allowed to execute.",
      "items": {
        "type": "object",
        "required": [
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "description": "The binary executable name (must match a requirement id)"
          },
          "description": {
            "type": "string",
            "description": "Human-readable explanation of what this command does"
          },
          "actions": {
            "type": "array",
            "description": "Named actions/subcommands this plugin may invoke",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "description": "Allowed argument patterns for this command",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "description": "Fixed argument value (e.g. --format, --output)"
                },
                "validator": {
                  "type": "string",
                  "description": "Regex pattern to validate a dynamic argument."
                }
              }
            }
          }
        }
      }
    },
    "networkAccess": {
      "type": "object",
      "description": "Granular network access control. Required when using the 'network' permission.",
      "additionalProperties": false,
      "properties": {
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of allowed domains. Use * for wildcard."
        },
        "reasoning": {
          "type": "string",
          "description": "Required when allowedDomains contains '*'."
        }
      }
    },
    "readPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Filesystem paths the plugin may read."
    },
    "writePaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Filesystem paths the plugin may write to."
    },
    "unsafeFlags": {
      "type": "array",
      "description": "Unsafe capabilities.",
      "items": {
        "type": "object",
        "required": [
          "flag",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "flag": {
            "type": "string",
            "enum": [
              "dom-script-manipulation",
              "dom-link-manipulation",
              "unrestricted-network",
              "unrestricted-filesystem"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "watchtower": {
      "type": "object",
      "description": "Watchtower app compatibility info",
      "additionalProperties": false,
      "properties": {
        "minVersion": {
          "type": "string"
        },
        "semverConstraint": {
          "type": "string"
        },
        "apis": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Storage",
              "Download",
              "Notification",
              "Player",
              "Reader",
              "HTTP",
              "Database",
              "Cache",
              "Crypto",
              "Media",
              "Search",
              "Theme",
              "Localization",
              "Account",
              "Marketplace",
              "Cron",
              "System",
              "AniList",
              "Debrid",
              "TorrentClient",
              "SecureStorage"
            ]
          }
        }
      }
    },
    "userConfig": {
      "type": "object",
      "description": "User-configurable settings shown in the plugin settings screen",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "type",
              "label"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "select",
                  "secret"
                ]
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "default": {},
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "license": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "changelog": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "description": "Required when runtime is 'remote'."
    },
    "isNsfw": {
      "type": "boolean",
      "default": false
    },
    "requiresAccount": {
      "type": "boolean",
      "default": false
    },
    "paywall": {
      "type": "string",
      "enum": [
        "free",
        "freemium",
        "premium"
      ],
      "default": "free"
    }
  },
  "if": {
    "properties": {
      "runtime": {
        "const": "remote"
      }
    },
    "required": [
      "runtime"
    ]
  },
  "then": {
    "required": [
      "endpoint"
    ]
  }
}
