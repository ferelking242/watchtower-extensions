{
  "_comment": "Plugin registry — submit a PR to add your plugin",
  "_schema": "https://raw.githubusercontent.com/ferelking242/watchtower-extensions/main/plugins/schema.json",
  "_templates": "https://github.com/ferelking242/watchtower-extensions/tree/main/plugins/_templates",
  "_lastUpdated": "2026-06-16",
  "plugins": [
    {
      "id": "com.watchtower.youtube-downloader",
      "name": "YouTube Downloader",
      "version": "1.0.0",
      "author": "Watchtower Team",
      "description": "Télécharge des vidéos et audio YouTube en haute qualité. Propulsé par ZeusDL.",
      "longDescription": "Téléchargez n'importe quelle vidéo YouTube, playlist ou audio directement dans Watchtower.\n\nSupporte le **MP4 jusqu'en 4K**, l'extraction audio **MP3/M4A**, les **sous-titres** et les **playlists complètes**.\n\n**Requiert ZeusDL** — le moteur de téléchargement intégré de Watchtower qui gère les restrictions YouTube, le renouvellement des tokens et la gestion des streams adaptatifs.",
      "schemaVersion": "2",
      "icon": "https://raw.githubusercontent.com/ferelking242/watchtower-extensions/main/plugins/com.watchtower.youtube-downloader/assets/icon.png",
      "banner": "",
      "screenshots": [],
      "category": "downloader",
      "runtimeTypes": [
        "downloader"
      ],
      "ui": {
        "method": "json",
        "schema": "ui/schema.json",
        "htmlFallback": "ui/index.html",
        "evalSource": "ui/main.dart",
        "template": "downloader"
      },
      "permissions": [
        "network",
        "downloads",
        "storage.read",
        "storage.write",
        "notifications",
        "filesystem"
      ],
      "requirements": {
        "zeusdl": {
          "version": ">=1.0.0",
          "optional": false
        },
        "ffmpeg": {
          "version": ">=5.0.0",
          "optional": true
        }
      },
      "commandScopes": [
        "zeusdl",
        "ffmpeg"
      ],
      "networkAccess": [
        "*.youtube.com",
        "*.youtu.be",
        "*.googlevideo.com",
        "*.ytimg.com"
      ],
      "writePaths": [
        "$DOWNLOADS/YouTube"
      ],
      "userConfig": {
        "fields": [
          {
            "key": "defaultQuality",
            "type": "select",
            "label": "Qualité par défaut",
            "options": [
              "4K",
              "1080p",
              "720p",
              "480p",
              "360p",
              "audio only"
            ],
            "default": "1080p"
          },
          {
            "key": "defaultFormat",
            "type": "select",
            "label": "Format par défaut",
            "options": [
              "mp4",
              "mp3",
              "m4a",
              "webm"
            ],
            "default": "mp4"
          },
          {
            "key": "saveFolder",
            "type": "string",
            "label": "Dossier de sauvegarde",
            "default": "$DOWNLOADS/YouTube"
          },
          {
            "key": "embedSubtitles",
            "type": "boolean",
            "label": "Intégrer les sous-titres",
            "default": false
          },
          {
            "key": "downloadThumbnail",
            "type": "boolean",
            "label": "Télécharger la miniature",
            "default": true
          }
        ]
      },
      "tags": [
        "youtube",
        "download",
        "video",
        "audio",
        "playlist",
        "4k"
      ],
      "license": "MIT",
      "isNsfw": false,
      "requiresAccount": false,
      "paywall": "free",
      "downloads": 0,
      "rating": 0,
      "featured": true,
      "publishedAt": "2026-06-16"
    },
    {
      "id": "com.watchtower.tiktok-downloader",
      "name": "TikTok Downloader",
      "version": "1.0.0",
      "author": "Watchtower Team",
      "description": "Download TikTok videos and slideshows in HD without watermark. Powered by ZeusDL.",
      "longDescription": "Download any TikTok video, slideshow, or audio track directly into Watchtower.\n\nSupports **watermark removal**, **HD quality**, **audio-only mode**, and **batch downloads**.\n\n**Requires ZeusDL** — Watchtower's built-in download engine that handles TikTok's anti-bot protection, rotating sessions and rate-limiting automatically.\n\n**Optional: FFmpeg** for 1080p quality (merges audio+video streams).",
      "icon": "https://raw.githubusercontent.com/ferelking242/watchtower-extensions/main/plugins/com.watchtower.tiktok-downloader/assets/icon.svg",
      "banner": "",
      "screenshots": [],
      "category": "downloader",
      "runtime": "javascript",
      "ui": "webview",
      "permissions": [
        "network",
        "downloads",
        "storage.read",
        "storage.write",
        "notifications",
        "filesystem",
        "system"
      ],
      "requirements": [
        {
          "id": "zeusdl",
          "version": ">=1.0.0",
          "optional": false,
          "reason": "ZeusDL handles TikTok session management, watermark removal and HD extraction."
        },
        {
          "id": "ffmpeg",
          "version": ">=5.0.0",
          "optional": true,
          "reason": "Merges audio+video streams for 1080p quality."
        }
      ],
      "commandScopes": [
        {
          "command": "zeusdl",
          "description": "Download TikTok videos without watermark"
        },
        {
          "command": "ffmpeg",
          "description": "Merge audio and video streams for HD quality"
        }
      ],
      "networkAccess": {
        "allowedDomains": [
          "*.tiktok.com",
          "*.tiktokcdn.com",
          "*.tiktokv.com",
          "*.bytedance.com"
        ]
      },
      "writePaths": [
        "$DOWNLOADS/TikTok"
      ],
      "watchtower": {
        "minVersion": "1.0.0",
        "apis": [
          "HTTP",
          "Download",
          "Notification",
          "Storage",
          "Cache",
          "System"
        ]
      },
      "userConfig": {
        "fields": [
          {
            "key": "defaultQuality",
            "type": "select",
            "label": "Default quality",
            "options": [
              "1080p",
              "720p",
              "480p",
              "360p",
              "audio only"
            ],
            "default": "720p"
          },
          {
            "key": "saveFolder",
            "type": "string",
            "label": "Save folder",
            "default": "$DOWNLOADS/TikTok"
          },
          {
            "key": "removeWatermark",
            "type": "boolean",
            "label": "Remove watermark",
            "default": true
          },
          {
            "key": "audioOnly",
            "type": "boolean",
            "label": "Audio only",
            "default": false
          }
        ]
      },
      "tags": [
        "tiktok",
        "download",
        "video",
        "watermark-free",
        "hd",
        "social"
      ],
      "license": "MIT",
      "repository": "https://github.com/ferelking242/watchtower-extensions/tree/main/plugins/com.watchtower.tiktok-downloader",
      "isNsfw": false,
      "requiresAccount": false,
      "paywall": "free",
      "downloads": 0,
      "rating": 0,
      "featured": true,
      "publishedAt": "2026-06-09"
    },
