{
  "id": "com.watchtower.facebook-downloader",
  "name": "Facebook Downloader",
  "version": "1.0.0",
  "author": "Watchtower Team",
  "description": "Download Facebook videos and Reels in HD. Powered by ZeusDL.",
  "longDescription": "Download any Facebook video or Reel directly into Watchtower. Supports HD quality, audio extraction, and private video download when logged in.\n\n**Requires ZeusDL** — Watchtower's built-in download engine.",
  "icon": "assets/icon.png",
  "category": "downloader",
  "tags": [
    "facebook",
    "reels",
    "download",
    "video",
    "hd",
    "social"
  ],
  "runtime": "binary",
  "ui": {
    "method": "json",
    "schema": "ui/schema.json"
  },
  "permissions": [
    "network",
    "downloads",
    "storage.read",
    "storage.write",
    "notifications",
    "filesystem"
  ],
  "requirements": [
    {
      "id": "zeusdl",
      "version": ">=1.0.0",
      "optional": false,
      "reason": "ZeusDL handles Facebook session management and HD extraction."
    }
  ],
  "commandScopes": [
    {
      "command": "zeusdl",
      "description": "Download Facebook videos and Reels"
    }
  ],
  "networkAccess": {
    "allowedDomains": [
      "*.facebook.com",
      "*.fbcdn.net",
      "*.fb.com"
    ]
  },
  "writePaths": [
    "$DOWNLOADS/Facebook"
  ],
  "userConfig": {
    "fields": [
      {
        "key": "defaultQuality",
        "type": "select",
        "label": "Default quality",
        "options": [
          "1080p",
          "720p",
          "480p",
          "360p",
          "audio only"
        ],
        "default": "720p"
      },
      {
        "key": "saveFolder",
        "type": "string",
        "label": "Save folder",
        "default": "$DOWNLOADS/Facebook",
        "description": "Where to save downloaded files"
      }
    ]
  },
  "watchtower": {
    "minVersion": "8.1.0",
    "apis": [
      "HTTP",
      "Download",
      "Notification",
      "Storage",
      "Cache"
    ]
  },
  "license": "MIT",
  "isNsfw": false,
  "requiresAccount": false,
  "paywall": "free"
}