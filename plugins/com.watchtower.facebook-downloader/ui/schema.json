{
  "title": "Facebook Downloader",
  "version": "1",
  "sections": [
    {
      "title": "Téléchargement",
      "inputs": [
        {
          "key": "url",
          "type": "text",
          "label": "URL Facebook",
          "placeholder": "https://www.facebook.com/watch/?v=...",
          "required": true
        },
        {
          "key": "defaultQuality",
          "type": "select",
          "label": "Qualité",
          "options": [
            "1080p",
            "720p",
            "480p",
            "360p",
            "audio only"
          ],
          "default": "720p"
        },
        {
          "key": "audioOnly",
          "type": "boolean",
          "label": "Audio seulement",
          "default": false
        }
      ]
    }
  ]
}