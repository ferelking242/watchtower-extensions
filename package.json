{
  "name": "watchtower-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "Watchtower extensions repository \u2014 CI validation scripts",
  "scripts": {
    "validate": "node tools/validate-extensions.mjs",
    "test:taxonomy": "node tools/test_catalog_taxonomy.mjs",
    "tags": "node tools/generate_tags.mjs",
    "tags:check": "node tools/generate_tags.mjs --check",
    "pin": "node tools/pin_sources.mjs --all",
    "pin:check": "node tools/pin_sources.mjs --check --all",
    "test:frenchstream": "node tools/test-frenchstream.mjs",
    "test:xnxx": "node tools/test-xnxx.mjs",
    "test:xvideos": "node tools/test-xvideos.mjs",
    "test:eporner": "node tools/test-eporner.mjs",
    "test:imhentai": "node tools/test-imhentai.mjs",
    "test:allmanga": "node tools/test-allmanga.mjs",
    "test:harimanga-covers": "node tools/test-harimanga-covers.mjs",
    "validate:live": "files=$(find src/nsfw -type f -name '*.js' -print | sort | paste -sd, -) && node tools/run_all_tests.mjs --files \"$files\" --deep --strict --concurrency 4 --out tools/live-report.json"
  },
  "engines": {
    "node": ">=18"
  }
}
