import "module:std" as std

import { DeezerApi } from '../api/deezer_api.ht'
import { Converters } from '../converter/converter.ht'

var FutureUtils = std.FutureUtils

class SearchEndpoint {
  var api: DeezerApi

  construct (this.api)

  get chips -> List {
    return ["all", "tracks", "albums", "artists", "playlists"]
  }

  fun all(query: string) {
    var params = { q: query, limit: 20 }.toJson()

    return FutureUtils.chain([
      () => api.fetch("/search/track", params: params),
      () => api.fetch("/search/album", params: params),
      () => api.fetch("/search/artist", params: params),
      () => api.fetch("/search/playlist", params: params),
    ]).then((results) {
      return {
        artists: Converters.fullArtists(results[2]?["data"] ?? []),
        albums: Converters.simpleAlbums(results[1]?["data"] ?? []),
        tracks: Converters.fullTracks(results[0]?["data"] ?? []),
        playlists: Converters.simplePlaylists(results[3]?["data"] ?? []),
      }.toJson()
    })
  }

  fun albums(query: string, { offset: int, limit: int }) {
    return api.fetch("/search/album", params: { q: query, index: offset, limit: limit }).then(
      (data) => Converters.paginated(data, offset, limit, (items) => Converters.simpleAlbums(items))
    )
  }

  fun artists(query: string, { offset: int, limit: int }) {
    return api.fetch("/search/artist", params: { q: query, index: offset, limit: limit }).then(
      (data) => Converters.paginated(data, offset, limit, (items) => Converters.fullArtists(items))
    )
  }

  fun tracks(query: string, { offset: int, limit: int }) {
    return api.fetch("/search/track", params: { q: query, index: offset, limit: limit }).then(
      (data) => Converters.paginated(data, offset, limit, (items) => Converters.fullTracks(items))
    )
  }

  fun playlists(query: string, { offset: int, limit: int }) {
    return api.fetch("/search/playlist", params: { q: query, index: offset, limit: limit }).then(
      (data) => Converters.paginated(data, offset, limit, (items) => Converters.simplePlaylists(items))
    )
  }
}

export { SearchEndpoint }
