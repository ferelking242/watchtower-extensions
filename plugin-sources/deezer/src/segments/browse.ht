import "module:std" as std

import { DeezerApi } from '../api/deezer_api.ht'
import { Converters } from '../converter/converter.ht'

var FutureUtils = std.FutureUtils

class BrowseEndpoint {
  var api: DeezerApi

  construct (this.api)

  fun _section(id: string, title: string, items: List) -> Map {
    return {
      id: id,
      title: title,
      externalUri: "https://www.deezer.com/charts",
      browseMore: false,
      items: items,
    }.toJson()
  }

  /// Real editorial sections, straight from Deezer's chart endpoints. Nothing
  /// is invented: each section is whatever the API returns and empty sections
  /// are dropped. A section whose endpoint fails is skipped, not fatal.
  fun sections({ offset: int, limit: int }) {
    var lim = limit ?? 20

    return FutureUtils.chain([
      () => api.fetch("/chart/0/playlists", params: { limit: lim }),
      () => api.fetch("/chart/0/albums", params: { limit: lim }),
      () => api.fetch("/chart/0/tracks", params: { limit: lim }),
      () => api.fetch("/genre/132/artists", params: { limit: lim }),
    ]).then((results) {
      var sections = []

      var playlists = Converters.simplePlaylists(results[0]?["data"] ?? [])
      if (!playlists.isEmpty) sections.add(_section("chart:playlists", "Top Playlists", playlists))

      var albums = Converters.simpleAlbums(results[1]?["data"] ?? [])
      if (!albums.isEmpty) sections.add(_section("chart:albums", "Top Albums", albums))

      var tracks = Converters.fullTracks(results[2]?["data"] ?? [])
      if (!tracks.isEmpty) sections.add(_section("chart:tracks", "Top Tracks", tracks))

      var artists = Converters.fullArtists(results[3]?["data"] ?? [])
      if (!artists.isEmpty) sections.add(_section("genre:artists", "Popular Artists", artists))

      return {
        limit: lim,
        nextOffset: null,
        total: sections.length,
        hasMore: false,
        items: sections,
      }.toJson()
    })
  }

  fun sectionItems(id: string, { offset: int, limit: int }) {
    var parts = id.split(":")
    var kind = parts[0]
    var which = parts.length > 1 ? parts[1] : ""

    if (kind == "chart") {
      return api.fetch("/chart/0/${which}", params: { index: offset, limit: limit }).then((data) {
        if (which == "playlists") {
          return Converters.paginated(data, offset, limit, (items) => Converters.simplePlaylists(items))
        }
        if (which == "albums") {
          return Converters.paginated(data, offset, limit, (items) => Converters.simpleAlbums(items))
        }
        return Converters.paginated(data, offset, limit, (items) => Converters.fullTracks(items))
      })
    }

    if (kind == "genre") {
      return api.fetch("/genre/132/artists", params: { index: offset, limit: limit }).then(
        (data) => Converters.paginated(data, offset, limit, (items) => Converters.fullArtists(items))
      )
    }

    return {
      limit: limit ?? 20,
      nextOffset: null,
      total: 0,
      hasMore: false,
      items: [],
    }.toJson()
  }
}

export { BrowseEndpoint }
