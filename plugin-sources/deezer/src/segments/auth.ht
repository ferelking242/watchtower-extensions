import 'module:std' as std
import 'module:spotube_plugin' as spotube

import { DeezerApi } from '../api/deezer_api.ht'

var StreamController = std.StreamController
var Stream = std.Stream
var JSON = std.JSON
var LocalStorage = spotube.LocalStorage
var SpotubeForm = spotube.SpotubeForm

/// Deezer authentication is a single long-lived cookie, the **ARL**.
///
/// The public catalogue needs no credentials at all, so this endpoint only
/// exists to unlock the signed-in user's own library (favourites, playlists).
/// The user pastes their `arl` cookie value; we resolve it against the
/// `gw-light` gateway to obtain the per-session `checkForm` token and the
/// user id, and persist all three.
class DeezerAuthEndpoint {
  final controller: StreamController
  var credentials: Map
  var api: DeezerApi

  get authStateStream -> Stream => controller.stream

  construct (this.api) {
    controller = StreamController.broadcast()
    initializeFromLocalStorage()
  }

  fun initializeFromLocalStorage() {
    LocalStorage.getString("credentials").then((credStr) {
      if (credStr == null || credStr.isEmpty) return

      credentials = JSON.decode(credStr)
      api.setCredentials(
        arl: credentials["arl"],
        checkForm: credentials["checkForm"],
        userId: credentials["userId"],
      )
      controller.add({ type: "recovered" }.toJson())
    })
  }

  fun isAuthenticated() -> bool {
    return credentials != null && api.isAuthenticated()
  }

  /// Prompts for the ARL and validates it before persisting.
  fun authenticate() -> Future {
    return SpotubeForm.show(
      "Deezer Login",
      [
        {
          objectType: "text",
          text: "The public Deezer catalogue works without an account. To use your own library (favourites, playlists), paste your `arl` cookie.",
        }.toJson(),
        {
          objectType: "input",
          id: "arl",
          variant: "text",
          placeholder: "arl cookie value",
          required: true,
        }.toJson(),
        {
          objectType: "text",
          text: "In a browser signed in to deezer.com, open DevTools → Application → Cookies and copy the value of `arl`.",
        }.toJson(),
      ],
    ).then((values) {
      if (values == null) return

      var arl
      for (var value in values) {
        if (value["id"] == "arl") arl = value["value"]
      }

      if (arl == null || arl.trim().isEmpty) return

      return login(arl.trim())
    })
  }

  fun login(arl: string) -> Future {
    return api.resolveSession(arl).then((session) {
      if (session == null) {
        throw "Deezer rejected this ARL. Check that you copied the whole cookie value."
      }

      credentials = session
      api.setCredentials(
        arl: session["arl"],
        checkForm: session["checkForm"],
        userId: session["userId"],
      )
      LocalStorage.setString("credentials", JSON.encode(credentials.toJson()))
      controller.add({ type: "login" }.toJson())
      return true
    })
  }

  fun logout() {
    credentials = null
    api.setCredentials(arl: "", checkForm: "null", userId: 0)
    LocalStorage.remove("credentials")
    controller.add({ type: "logout" }.toJson())
  }
}

export { DeezerAuthEndpoint }
