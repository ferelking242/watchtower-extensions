import { DeezerApi } from '../api/deezer_api.ht'
import { UserLibrary } from '../library/user_library.ht'
import { Converters } from '../converter/converter.ht'

class UserEndpoint {
  var api: DeezerApi
  var library: UserLibrary

  construct (this.api, this.library)

  fun me() {
    return library.me()
  }

  fun savedTracks({ offset: int, limit: int }) {
    return library.savedTracks(offset: offset, limit: limit)
  }

  fun savedPlaylists({ offset: int, limit: int }) {
    return library.savedPlaylists(offset: offset, limit: limit)
  }

  fun savedAlbums({ offset: int, limit: int }) {
    return library.savedAlbums(offset: offset, limit: limit)
  }

  fun savedArtists({ offset: int, limit: int }) {
    return library.savedArtists(offset: offset, limit: limit)
  }

  fun isSavedTracks(trackIds: List) {
    return library.areTracksFavorite(trackIds)
  }

  fun isSavedAlbums(albumIds: List) {
    return library.areAlbumsFavorite(albumIds)
  }

  fun isSavedArtists(artistIds: List) {
    return library.areArtistsFavorite(artistIds)
  }

  fun isSavedPlaylist(playlistId: string) {
    return library.isPlaylistFavorite(playlistId)
  }
}

export { UserEndpoint }
