import "module:std" as std

import { DeezerApi } from '../api/deezer_api.ht'
import { UserLibrary } from '../library/user_library.ht'
import { Converters } from '../converter/converter.ht'

var FutureUtils = std.FutureUtils

class PlaylistEndpoint {
  var api: DeezerApi
  var library: UserLibrary

  construct (this.api, this.library)

  fun getPlaylist(id: string) {
    return api.fetch("/playlist/${id}").then((playlist) {
      if (playlist == null || playlist["id"] == null) return null
      return Converters.fullPlaylists([playlist])[0]
    })
  }

  fun tracks(id: string, { offset: int, limit: int }) {
    return api.fetch("/playlist/${id}/tracks", params: { index: offset, limit: limit }).then((data) {
      return Converters.paginated(data, offset, limit, (items) => Converters.fullTracks(items))
    })
  }

  /// Editing playlists is a `gw-light` operation: the public catalogue is
  /// read-only. These require a signed-in ARL session.
  fun create(userId: string, { name: string, description: string, public: bool, collaborative: bool }) {
    return api.call("playlist.create", params: {
      title: name,
      description: description,
    }).then((results) {
      var id = results?["PLAYLIST_ID"] ?? results?["id"]
      if (id == null) return null
      return getPlaylist(id.toString())
    })
  }

  fun update(playlistId: string, { name: string, description: string, public: bool, collaborative: bool }) {
    return api.call("playlist.update", params: {
      playlist_id: playlistId,
      title: name,
      description: description,
    }).then((_) => true)
  }

  fun addTracks(playlistId: string, { trackIds: List, position: int }) {
    return api.call("playlist.addSongs", params: {
      playlist_id: playlistId,
      songs: trackIds.join(","),
    }).then((_) => true)
  }

  fun removeTracks(playlistId: string, { trackIds: List }) {
    return api.call("playlist.deleteSongs", params: {
      playlist_id: playlistId,
      songs: trackIds.join(","),
    }).then((_) => true)
  }

  fun deletePlaylist(playlistId: string) {
    return api.call("playlist.delete", params: { playlist_id: playlistId }).then((_) => true)
  }

  fun save(playlistId: string) {
    return library.addFavoritePlaylist([playlistId])
  }

  fun unsave(playlistId: string) {
    return library.removeFavoritePlaylist([playlistId])
  }
}

export { PlaylistEndpoint }
