import { DeezerApi } from '../api/deezer_api.ht'
import { UserLibrary } from '../library/user_library.ht'
import { Converters } from '../converter/converter.ht'

class ArtistEndpoint {
  var api: DeezerApi
  var library: UserLibrary

  construct (this.api, this.library)

  fun getArtist(id: string) {
    return api.fetch("/artist/${id}").then((artist) {
      if (artist == null || artist["id"] == null) return null
      return Converters.fullArtists([artist])[0]
    })
  }

  fun topTracks(id: string, { offset: int, limit: int }) {
    return api.fetch("/artist/${id}/top", params: { index: offset, limit: limit }).then((data) {
      return Converters.paginated(data, offset, limit, (items) => Converters.fullTracks(items))
    })
  }

  fun albums(id: string, { offset: int, limit: int }) {
    return api.fetch("/artist/${id}/albums", params: { index: offset, limit: limit }).then((data) {
      return Converters.paginated(data, offset, limit, (items) => Converters.simpleAlbums(items))
    })
  }

  fun related(id: string, { offset: int, limit: int }) {
    return api.fetch("/artist/${id}/related", params: { index: offset, limit: limit }).then((data) {
      return Converters.paginated(data, offset, limit, (items) => Converters.fullArtists(items))
    })
  }

  fun save(artistIds: List) {
    return library.addFavoriteArtist(artistIds)
  }

  fun unsave(artistIds: List) {
    return library.removeFavoriteArtist(artistIds)
  }
}

export { ArtistEndpoint }
