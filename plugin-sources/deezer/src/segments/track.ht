import { DeezerApi } from '../api/deezer_api.ht'
import { UserLibrary } from '../library/user_library.ht'
import { Converters } from '../converter/converter.ht'

class TrackEndpoint {
  var api: DeezerApi
  var library: UserLibrary

  construct (this.api, this.library)

  fun getTrack(id: string) {
    return api.fetch("/track/${id}").then((track) {
      if (track == null || track["id"] == null) return null
      return Converters.fullTracks([track])[0]
    })
  }

  fun save(trackIds: List) {
    return library.addFavoriteTrack(trackIds)
  }

  fun unsave(trackIds: List) {
    return library.removeFavoriteTrack(trackIds)
  }

  /// Deezer has no public "track radio" endpoint; the artist's top tracks are
  /// the closest real substitute.
  fun radio(trackId: string) {
    return api.fetch("/track/${trackId}").then((track) {
      var artistId = track?["artist"]?["id"]
      if (artistId == null) return Converters.fullTracks([track])

      return api.fetch("/artist/${artistId}/top", params: { limit: 25 }).then((data) {
        return Converters.fullTracks(data?["data"] ?? [])
      })
    })
  }
}

export { TrackEndpoint }
