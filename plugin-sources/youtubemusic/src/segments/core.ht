import 'module:std' as std

var HttpClient = std.HttpClient
var HttpBaseOptions = std.HttpBaseOptions
var RequestOptions = std.RequestOptions

/// Plugin housekeeping: update checks and the support blurb.
// GitHub tags are not always semver: this repo publishes a single rolling
// "plugins-latest" release, and `int.parse` throws on such a tag. A version
// check must never take the plugin down, so an unusable tag simply means
// "no update to advertise".
fun isVersionNumber(part: String) -> bool {
  var i = 0
  if (part.startsWith("v")) i = 1
  if (i >= part.length) return false
  while (i < part.length) {
    var c = part.substring(i, i + 1)
    if (!"0123456789".contains(c)) return false
    i = i + 1
  }
  return true
}

fun parseVersionNumbers(tag) -> List {
  if (tag == null) return []
  var parts = "${tag}".split(".")
  if (parts.length < 3) return []
  if (!isVersionNumber(parts[0])) return []
  if (!isVersionNumber(parts[1])) return []
  if (!isVersionNumber(parts[2])) return []
  var major = int.parse(parts[0].replaceAll("v", ""))
  var minor = int.parse(parts[1].replaceAll("v", ""))
  var patch = int.parse(parts[2].replaceAll("v", ""))
  return [major, minor, patch]
}

fun isPluginAssetName(name) -> bool {
  if (name == null) return false
  var n = "${name}"
  if (n.length < 7) return false
  return n.substring(n.length - 7, n.length) == ".smplug"
}

class CorePlugin {
  var client: HttpClient

  construct () {
    client = HttpClient(
      HttpBaseOptions(baseUrl: "https://api.github.com")
    )
  }

  /// Checks the plugin's GitHub releases for a newer `.smplug`.
  ///
  /// [currentConfig] is the parsed `plugin.json`. Returns null when the plugin
  /// is up to date, otherwise a map with `downloadUrl`, `version` and
  /// `changelog`.
  fun checkUpdate(currentConfig: Map) -> Future {
    var currentVersion = parseVersionNumbers(currentConfig["version"] ?? "0.0.0")
    if (currentVersion.length < 3) return null
    var major = currentVersion[0]
    var minor = currentVersion[1]
    var patch = currentVersion[2]

    var repository = currentConfig["repository"] ?? ""
    if (repository == "") return Future.value(null)
    var slug = repository.replaceAll("https://github.com/", "").replaceAll("https://api.github.com/repos/", "")

    return client.get_req(
      "/repos/${slug}/releases/latest",
      options: RequestOptions(
        headers: { "Accept": "application/vnd.github.v3+json" }.toJson()
      ),
    ).then((res) {
      var data = res.data
      var tag = data["tag_name"] ?? ""
      var latest = parseVersionNumbers(tag)
      if (latest.length < 3) return null

      var latestMajor = latest[0]
      var latestMinor = latest[1]
      var latestPatch = latest[2]

      var available = latestMajor > major ||
        (latestMajor == major && latestMinor > minor) ||
        (latestMajor == major && latestMinor == minor && latestPatch > patch)

      if (!available) return null

      var downloadUrl = null
      var assets = data["assets"] ?? []
      for (var asset in assets) {
        if (isPluginAssetName(asset["name"])) {
          downloadUrl = asset["browser_download_url"]
          break
        }
      }
      if (downloadUrl == null) return null

      return {
        "downloadUrl": downloadUrl,
        "version": tag,
        "changelog": data["body"] ?? "",
      }.toJson()
    })
  }

  get support -> string {
    return '# YouTube Music\n\nYouTube Music metadata is read through the public InnerTube API (`music.youtube.com/youtubei/v1`), the same backend the web player uses.\n\nNo account is required for search, playlists and artist pages. Signing in is optional and only adds the saved-library features (liked music, saved albums and artists).\n\nAudio is resolved by the audio source plugin you select (for example *YouTube Audio*), not by this plugin.'
  }
}

export { CorePlugin }
