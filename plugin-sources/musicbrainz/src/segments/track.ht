import "module:std" as std
import { ResilientHttpClient } from "../common/http.ht"
import { MbConverter } from "./converter.ht"

var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse

class TrackEndpoint {
  var lbApi: ResilientHttpClient
  var mbApi: ResilientHttpClient
  final username: string

  construct (this.lbApi, this.mbApi, this.username)

  /// Feedback (likes) is stored on the ListenBrainz account, so signed out
  /// there is nowhere to write and the API answers 401.
  get isAuthenticated -> bool {
    return username != null && username.isNotEmpty
  }

  fun getTrack(id: string) {
    return mbApi.get_req(
      "/recording/${id}",
      queryParameters: {
        fmt: "json",
        inc: "artist-credits+releases+release-groups+isrcs"
      }.toJson()
    ).then((res) {
      var data = res.data
      var track = MbConverter.recordings([data]).first
      return track
    })
  }

  fun save(trackIds: List) {
    if (!isAuthenticated) {
      return Future.value(null)
    }

    return Future.wait(
      trackIds.map((id) {
        return lbApi.post(
          "/feedback/recording-feedback",
          data: {
            recording_mbid: id,
            score: 1,
          }.toJson(),
        )
      }).toList()
    ).then((res)=>null)
  }

  fun unsave(trackIds: List) {
    if (!isAuthenticated) {
      return Future.value(null)
    }

    return Future.wait(
      trackIds.map((id) {
        return lbApi.post(
          "/feedback/recording-feedback",
          data: {
            recording_mbid: id,
            score: 0,
          }.toJson(),
        )
      }).toList()
    ).then((res)=>null)
  }

  fun radio(id: string) {
    return mbApi.get_req(
      "/recording/${id}",
      queryParameters: {
        fmt: "json",
        inc: "artist-credits+tags"
      }.toJson()
    ).then((res) {
      var data = res.data
      var artistIds = data["artist-credit"].map((credit) => credit["artist"]["id"]).toList()
      var tags = data["tags"]?.map((tag) => tag["name"])?.toList() ?? []
      var artistQuery = artistIds.map((id)=>"artist:(${id})").join(" ")
      var tagsQuery = tags.join(",")
      var query = "${artistQuery}"
      if (tagsQuery.isNotEmpty) {
        query += " tag:(${tagsQuery}):2:easy"
      }

      // ListenBrainz answers 401 on /explore/lb-radio without a token, so a
      // signed-out user gets the same radio straight from MusicBrainz search.
      if (username == null || username.isEmpty) {
        var mbQuery = query.replaceAll("artist:(", "arid:(")
        return mbApi.get_req(
          "/recording",
          queryParameters: {
            fmt: "json",
            query: mbQuery,
            limit: 25,
            inc: "artist-credits+releases+release-groups+isrcs",
          }.toJson(),
        ).then((res) {
          return MbConverter.recordings(res.data["recordings"] ?? [])
        })
      }

      return lbApi.get_req(
        "/explore/lb-radio",
        queryParameters: {
          prompt: query,
          mode: "easy"
        }.toJson(),
      ).then((res) {
        var recordingMbids = res.data["payload"]["jspf"]["playlist"]["track"]
          .map((track) => "rid:${track["identifier"][0].split("/").last}").toList()

        return mbApi.get_req(
          "/recording",
          queryParameters: {
            fmt: "json",
            query: recordingMbids.join(" OR "),
            inc: "artist-credits+releases+release-groups+isrcs",
          }.toJson(),
        ).then((res) {
          var tracks = MbConverter.recordings(res.data["recordings"]).toList()
          return tracks
        })
      })
    })
  }
}

export { TrackEndpoint }