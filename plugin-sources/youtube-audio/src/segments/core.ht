import "module:std" as std

var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse
var RequestOptions = std.RequestOptions

// GitHub tags are not always semver: this repo publishes a single rolling
// "plugins-latest" release, and `int.parse` throws on such a tag. A version
// check must never take the plugin down, so an unusable tag simply means
// "no update to advertise".
fun isVersionNumber(part: String) -> bool {
  var i = 0
  if (part.startsWith("v")) i = 1
  if (i >= part.length) return false
  while (i < part.length) {
    var c = part.substring(i, i + 1)
    if (!"0123456789".contains(c)) return false
    i = i + 1
  }
  return true
}

fun parseVersionNumbers(tag) -> List {
  if (tag == null) return []
  var parts = "${tag}".split(".")
  if (parts.length < 3) return []
  if (!isVersionNumber(parts[0])) return []
  if (!isVersionNumber(parts[1])) return []
  if (!isVersionNumber(parts[2])) return []
  var major = int.parse(parts[0].replaceAll("v", ""))
  var minor = int.parse(parts[1].replaceAll("v", ""))
  var patch = int.parse(parts[2].replaceAll("v", ""))
  return [major, minor, patch]
}

fun isPluginAssetName(name) -> bool {
  if (name == null) return false
  var n = "${name}"
  if (n.length < 7) return false
  return n.substring(n.length - 7, n.length) == ".smplug"
}


class CorePlugin {
  var client: HttpClient

  construct (this.client)

  /// Checks for updates to the plugin.
  /// [currentConfig] is just plugin.json's file content.
  ///
  /// If there's an update available, it will return a map of:
  /// - [downloadUrl] -> direct download url to the new plugin.smplug file.
  /// - [version] of the new plugin.
  /// - [changelog] Optionally, a changelog for the update (markdown supported).
  ///
  /// If no update is available, it will return null.
  fun checkUpdate(currentConfig: Map) -> Future {
    var currentVersion = parseVersionNumbers(currentConfig["version"])
    if (currentVersion.length < 3) return null
    var major = currentVersion[0]
    var minor = currentVersion[1]
    var patch = currentVersion[2]

    var repoSlug = (currentConfig["repository"] ?? "").replaceAll("https://github.com/", "")
    var releasesUrl = "https://api.github.com/repos/${repoSlug}/releases/latest"
    return client.get_req(
      releasesUrl,
      options: RequestOptions(
        headers: {
          "Accept": "application/vnd.github.v3+json"
        }.toJson()
      ),
    ).then((res) {
      var data = res.data
      var latestVersion = parseVersionNumbers(data["tag_name"])

      if (latestVersion.length < 3) return null

      var latestMajor = latestVersion[0]
      var latestMinor = latestVersion[1]
      var latestPatch = latestVersion[2]

      var isUpdateAvailable = latestMajor > major ||
        (latestMajor == major && latestMinor > minor) ||
        (latestMajor == major && latestMinor == minor && latestPatch > patch)

      if (!isUpdateAvailable) return null

      var downloadUrl = data["assets"].firstWhere(
        (asset) => isPluginAssetName(asset["name"]),
        orElse: () => null
      )?["browser_download_url"]

      if (downloadUrl == null) {
        return null
      }

      var changelog = data["body"] ?? "No changelog available"
      return {
        "downloadUrl": downloadUrl,
        "version": data["tag_name"],
        "changelog": changelog
      }.toJson()
    })
  }

  /// Returns the support information for the plugin in Markdown or plain text.
  /// Supports images and links.
  get support -> string {
    // TODO: Return support information
    return "
# Support

This project and lots of other projects use the following:

- [yt-dlp](https://github.com/yt-dlp/yt-dlp)
- [NewPipe](https://github.com/TeamNewPipe) 
- [youtube_explode_dart](https://github.com/Hexer10/youtube_explode_dart)

These are extremely hard to maintain projects as YouTube is constantly changing their APIs every week, making it
harder and harder to reverse engineer their protocols and retrieving audio/video streams. So please contribute to 
those projects financially or technically, however you can if you have the ability to do so.

## Financial donation links
- yt-dlp: [github.com/yt-dlp/yt-dlp/blob/master/Maintainers.md](https://github.com/yt-dlp/yt-dlp/blob/master/Maintainers.md#maintainers)
- NewPipe: [newpipe.net/donate](https://newpipe.net/donate/)
- YoutubeExplodeDart: [github.com/sponsors/Hexer10](https://github.com/sponsors/Hexer10)
"
  }

  /// Scrobble the provided details to the scrobbling service supported by the plugin.
  /// "scrobbling" must be set as an ability in the plugin.json
  /// [details] is a map containing the scrobble information, such as:
  /// - [id] -> The unique identifier of the track.
  /// - [title] -> The title of the track.
  /// - [artists] -> List of artists
  ///   - [id] -> The unique identifier of the artist.
  ///   - [name] -> The name of the artist.
  /// - [album] -> The album of the track
  ///   - [id] -> The unique identifier of the album.
  ///   - [name] -> The name of the album.
  /// - [timestamp] -> The timestamp of the scrobble (optional).
  /// - [duration_ms] -> The duration of the track in milliseconds (optional).
  /// - [isrc] -> The ISRC code of the track (optional).
  fun scrobble(details: Map) {
    // TODO: Implement scrobbling
  }
}

export { CorePlugin }